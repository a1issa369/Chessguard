# Public values only. Anything prefixed VITE_ is bundled into the browser
# JavaScript and visible to every visitor, so never put a secret here.
VITE_API_BASE=http://localhost:8000
VITE_SITE_URL=http://localhost:5173
# Lower this on slow hosts. Must not exceed the backend MAX_GAMES_LIMIT.
VITE_MAX_GAMES=10
